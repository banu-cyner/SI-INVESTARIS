* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --bg: #f4f7fb;
    --white: #ffffff;
    --text: #1e293b;
    --muted: #64748b;
    --border: #e2e8f0;
    --green: #16a34a;
    --yellow: #ca8a04;
    --red: #dc2626;
    --sidebar: #0f172a;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
}

/* SIDEBAR */

.sidebar {
    width: 250px;
    height: 100vh;
    position: fixed;
    left: 0;
    top: 0;
    background: var(--sidebar);
    color: white;
    padding: 25px 18px;
    display: flex;
    flex-direction: column;
    z-index: 1000;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 10px 30px;
}

.logo-icon {
    width: 45px;
    height: 45px;
    border-radius: 12px;
    background: var(--primary);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 22px;
}

.logo h2 {
    font-size: 18px;
}

.logo span {
    color: #94a3b8;
    font-size: 13px;
}

nav {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.nav-link {
    text-decoration: none;
    color: #cbd5e1;
    padding: 13px 15px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: .2s;
}

.nav-link:hover,
.nav-link.active {
    background: var(--primary);
    color: white;
}

.sidebar-footer {
    margin-top: auto;
    padding: 15px 10px;
    font-size: 12px;
    color: #94a3b8;
}

/* MAIN */

.main {
    margin-left: 250px;
    min-height: 100vh;
}

.topbar {
    background: white;
    padding: 22px 35px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.topbar h1 {
    font-size: 24px;
}

.topbar p {
    margin-top: 5px;
    color: var(--muted);
    font-size: 14px;
}

.menu-btn {
    display: none;
    border: none;
    background: none;
    font-size: 25px;
}

/* SECTION */

.section {
    padding: 30px 35px;
}

.welcome {
    background: linear-gradient(
        135deg,
        #2563eb,
        #4f46e5
    );

    border-radius: 18px;
    color: white;
    padding: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    overflow: hidden;
}

.welcome-label {
    font-size: 12px;
    opacity: .8;
    letter-spacing: 1px;
}

.welcome h2 {
    font-size: 28px;
    margin: 8px 0;
}

.welcome p {
    opacity: .85;
}

.welcome-icon {
    font-size: 100px;
    opacity: .15;
}

/* STATS */

.stats {
    margin-top: 25px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.stat-card {
    background: white;
    padding: 22px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    gap: 15px;
    box-shadow: 0 2px 10px rgba(0,0,0,.03);
}

.stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 22px;
}

.stat-card span {
    display: block;
    font-size: 13px;
    color: var(--muted);
}

.stat-card strong {
    display: block;
    font-size: 25px;
    margin-top: 5px;
}

.blue .stat-icon {
    color: #2563eb;
    background: #dbeafe;
}

.green .stat-icon {
    color: #16a34a;
    background: #dcfce7;
}

.yellow .stat-icon {
    color: #ca8a04;
    background: #fef9c3;
}

.red .stat-icon {
    color: #dc2626;
    background: #fee2e2;
}

/* SECTION HEADER */

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.section-header h2 {
    font-size: 22px;
}

.section-header p {
    color: var(--muted);
    font-size: 14px;
    margin-top: 5px;
}

/* BUTTON */

button {
    cursor: pointer;
    font-family: inherit;
}

.btn-primary {
    border: none;
    background: var(--primary);
    color: white;
    padding: 11px 17px;
    border-radius: 8px;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-weight: bold;
}

.btn-primary:hover {
    background: var(--primary-dark);
}

.btn-refresh {
    border: 1px solid var(--border);
    background: white;
    padding: 11px 15px;
    border-radius: 8px;
    color: var(--text);
}

.btn-refresh:hover {
    background: #f8fafc;
}

/* TOOLBAR */

.toolbar {
    background: white;
    padding: 15px;
    border-radius: 12px;
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
}

.search-box {
    position: relative;
    flex: 1;
}

.search-box i {
    position: absolute;
    left: 13px;
    top: 12px;
    color: var(--muted);
}

.search-box input {
    width: 100%;
    padding: 11px 12px 11px 38px;
    border: 1px solid var(--border);
    border-radius: 8px;
    outline: none;
}

.search-box input:focus {
    border-color: var(--primary);
}

.toolbar select {
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: white;
}

/* TABLE */

.table-container {
    background: white;
    border-radius: 12px;
    overflow-x: auto;
    box-shadow: 0 2px 10px rgba(0,0,0,.03);
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 950px;
}

th {
    background: #f8fafc;
    color: #475569;
    font-size: 12px;
    text-transform: uppercase;
    padding: 15px;
    text-align: left;
}

td {
    padding: 14px 15px;
    border-top: 1px solid var(--border);
    font-size: 14px;
}

tbody tr:hover {
    background: #f8fafc;
}

.loading {
    text-align: center;
    padding: 35px;
    color: var(--muted);
}

.loading i {
    margin-right: 7px;
}

.badge {
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: bold;
}

.badge-baik {
    background: #dcfce7;
    color: #15803d;
}

.badge-ringan {
    background: #fef9c3;
    color: #a16207;
}

.badge-berat {
    background: #fee2e2;
    color: #b91c1c;
}

.action-buttons {
    display: flex;
    gap: 5px;
}

.action-buttons button {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    border: none;
}

.edit-btn {
    background: #dbeafe;
    color: #2563eb;
}

.delete-btn {
    background: #fee2e2;
    color: #dc2626;
}

/* MODAL */

.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15,23,42,.55);
    display: none;
    justify-content: center;
    align-items: center;
    padding: 20px;
    z-index: 2000;
}

.modal-overlay.show {
    display: flex;
}

.modal {
    width: 650px;
    max-width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    background: white;
    border-radius: 16px;
    padding: 25px;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
}

.modal-header h2 {
    font-size: 20px;
}

.modal-header p {
    color: var(--muted);
    font-size: 13px;
    margin-top: 4px;
}

.close-btn {
    width: 35px;
    height: 35px;
    border: none;
    background: #f1f5f9;
    border-radius: 8px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    font-size: 13px;
    font-weight: bold;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 11px;
    border: 1px solid var(--border);
    border-radius: 8px;
    outline: none;
    font-family: inherit;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: var(--primary);
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 25px;
}

.btn-cancel {
    border: 1px solid var(--border);
    background: white;
    padding: 11px 17px;
    border-radius: 8px;
}

/* ABOUT */

.about-card {
    background: white;
    padding: 40px;
    border-radius: 15px;
    text-align: center;
}

.about-icon {
    width: 70px;
    height: 70px;
    margin: auto;
    border-radius: 20px;
    background: #dbeafe;
    color: var(--primary);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 32px;
}

.about-card h2 {
    margin: 15px 0 10px;
}

.about-card p {
    max-width: 650px;
    margin: auto;
    color: var(--muted);
    line-height: 1.7;
}

.features {
    margin-top: 25px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.features div {
    background: #f8fafc;
    padding: 15px;
    border-radius: 10px;
}

.features i {
    display: block;
    color: var(--primary);
    font-size: 22px;
    margin-bottom: 8px;
}

.features span {
    font-size: 12px;
}

/* TOAST */

.toast {
    position: fixed;
    right: 25px;
    bottom: 25px;
    background: #0f172a;
    color: white;
    padding: 14px 18px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    transform: translateY(100px);
    opacity: 0;
    transition: .3s;
    z-index: 3000;
}

.toast.show {
    transform: translateY(0);
    opacity: 1;
}

.toast i {
    color: #4ade80;
}

/* FOOTER */

footer {
    text-align: center;
    padding: 25px;
    color: var(--muted);
    font-size: 13px;
}


/* RESPONSIVE */

@media (max-width: 1000px) {

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .features {
        grid-template-columns: repeat(2, 1fr);
    }
}


@media (max-width: 750px) {

    .sidebar {
        transform: translateX(-100%);
        transition: .3s;
    }

    .sidebar.show {
        transform: translateX(0);
    }

    .main {
        margin-left: 0;
    }

    .menu-btn {
        display: block;
    }

    .topbar {
        padding: 18px 20px;
    }

    .topbar h1 {
        font-size: 18px;
    }

    .section {
        padding: 20px;
    }

    .welcome {
        padding: 22px;
    }

    .welcome h2 {
        font-size: 22px;
    }

    .welcome-icon {
        font-size: 65px;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .toolbar {
        flex-direction: column;
    }

    .section-header {
        align-items: flex-start;
        gap: 15px;
        flex-direction: column;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }
}


@media (max-width: 480px) {

    .stats {
        grid-template-columns: 1fr;
    }

    .features {
        grid-template-columns: 1fr;
    }

    .welcome-icon {
        display: none;
    }

    .modal {
        padding: 18px;
    }
}
